{
  "$defs": {
    "Interface": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Property"
          },
          "title": "Properties"
        }
      },
      "required": [
        "description",
        "properties"
      ],
      "title": "Interface",
      "type": "object"
    },
    "LinkType": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "cardinality": {
          "default": "many",
          "enum": [
            "many",
            "one"
          ],
          "title": "Cardinality",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target",
        "description"
      ],
      "title": "LinkType",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "owner": {
          "title": "Owner",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "aggregation": {
          "enum": [
            "count",
            "sum",
            "sum_product"
          ],
          "title": "Aggregation",
          "type": "string"
        },
        "fields": {
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "filters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Filters",
          "type": "object"
        },
        "dimensions": {
          "items": {
            "type": "string"
          },
          "title": "Dimensions",
          "type": "array"
        },
        "date_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Field"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "grain": {
          "title": "Grain",
          "type": "string"
        },
        "synonyms": {
          "items": {
            "type": "string"
          },
          "title": "Synonyms",
          "type": "array"
        },
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "certified"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "description",
        "owner",
        "type",
        "aggregation",
        "unit",
        "grain"
      ],
      "title": "Metric",
      "type": "object"
    },
    "ObjectType": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "owner": {
          "title": "Owner",
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Property"
          },
          "title": "Properties"
        },
        "synonyms": {
          "items": {
            "type": "string"
          },
          "title": "Synonyms",
          "type": "array"
        },
        "interfaces": {
          "items": {
            "type": "string"
          },
          "title": "Interfaces",
          "type": "array"
        },
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "certified"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "description",
        "owner",
        "properties"
      ],
      "title": "ObjectType",
      "type": "object"
    },
    "Policy": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "title": "Role",
          "type": "string"
        },
        "types": {
          "items": {
            "type": "string"
          },
          "title": "Types",
          "type": "array"
        },
        "metrics": {
          "items": {
            "type": "string"
          },
          "title": "Metrics",
          "type": "array"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Properties"
        },
        "row_attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Row Attributes",
          "type": "object"
        },
        "allow_pii": {
          "default": false,
          "title": "Allow Pii",
          "type": "boolean"
        }
      },
      "required": [
        "role",
        "types"
      ],
      "title": "Policy",
      "type": "object"
    },
    "Property": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "default": "string",
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "date"
          ],
          "title": "Type",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "pii": {
          "default": false,
          "title": "Pii",
          "type": "boolean"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "title": "Property",
      "type": "object"
    },
    "SourceMapping": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "title": "Type",
          "type": "string"
        },
        "kind": {
          "default": "csv",
          "enum": [
            "csv",
            "sqlite"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "table": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        },
        "id_column": {
          "title": "Id Column",
          "type": "string"
        },
        "columns": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Columns",
          "type": "object"
        },
        "links": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Links",
          "type": "object"
        }
      },
      "required": [
        "type",
        "path",
        "id_column",
        "columns"
      ],
      "title": "SourceMapping",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "namespace": {
      "pattern": "^[a-z][a-z0-9_-]*$",
      "title": "Namespace",
      "type": "string"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Version",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "types": {
      "additionalProperties": {
        "$ref": "#/$defs/ObjectType"
      },
      "title": "Types",
      "type": "object"
    },
    "links": {
      "additionalProperties": {
        "$ref": "#/$defs/LinkType"
      },
      "title": "Links",
      "type": "object"
    },
    "interfaces": {
      "additionalProperties": {
        "$ref": "#/$defs/Interface"
      },
      "title": "Interfaces",
      "type": "object"
    },
    "mappings": {
      "additionalProperties": {
        "$ref": "#/$defs/SourceMapping"
      },
      "title": "Mappings",
      "type": "object"
    },
    "metrics": {
      "additionalProperties": {
        "$ref": "#/$defs/Metric"
      },
      "title": "Metrics",
      "type": "object"
    },
    "policies": {
      "items": {
        "$ref": "#/$defs/Policy"
      },
      "title": "Policies",
      "type": "array"
    }
  },
  "required": [
    "namespace",
    "version",
    "description",
    "types"
  ],
  "title": "Ontology",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
